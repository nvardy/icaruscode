#include "dissonant_higgs.fcl"
# service configuration
#
#include "services_icarus_simulation.fcl"


process_name: dissHTree

services:
{
  @table::icarus_basic_services
  TFileService: { fileName: "dissonant_higgs_icarus.root" }
  IFDH: {}
}

source: {
  module_type: EmptyEvent
}

physics:
{
  producers: {
    generator: @local::dissonant_higgs
  } # analyzers
 
  ana:  [ generator ]
 
  trigger_paths: [ ana ] 
  end_paths:     [  ] 
  
} # physics

physics.producers.generator.RayTrace: @local::mxdraytrace
physics.producers.generator.Flux.IgnoreParentDecayTime: false
#physics.producers.generator.Flux.GlobalTimeOffset: 0.0
physics.producers.generator.Deweight: true
physics.producers.generator.MesonGen.FluxCopyMethod: "IFDH"
physics.producers.generator.MesonGen.SearchPath: "/pnfs/fnal.gov/usr/sbn/persistent/stash/physics-gputnam/numiflux/"
#physics.producers.generator.RayMaxWeightOverride: 1.0
physics.producers.generator.Flux.KDIFandBeamline: true
physics.producers.generator.Flux.SpillTimeConfig: "evgb::EvtTimeFNALBeam numi"
services.NuRandomService.policy: "random"
